# Copy this file to .env and fill in your own Auth0 application values.
# Never commit the real .env file (it's already in .gitignore).

AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret

# Session encryption secret used by the Auth0 SDK - generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
AUTH0_SECRET=replace-with-a-long-random-string

# Local: http://localhost:5000/callback
# Azure: https://<your-app-name>.azurewebsites.net/callback
AUTH0_REDIRECT_URI=http://localhost:5000/callback

# Optional - only needed if calling a separate Auth0-protected API
AUTH0_AUDIENCE=
